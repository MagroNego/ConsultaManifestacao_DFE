# Exemplo de variáveis não sensíveis/operacionais.
# INICIAR_WEB.cmd NÃO carrega este arquivo automaticamente.
# Senhas do banco, certificado e SMTP: arquivos de secrets/.
# Contas/senhas de acesso: hashes em dados/admin_accounts.db.

NFE_WEB_ENV=production
NFE_WEB_HOST=127.0.0.1
NFE_WEB_PORT=8080
NFE_WEB_FORWARDED_ALLOW_IPS=127.0.0.1
NFE_CERT_STORE=CurrentUser
# Cooldown fixo de 60 minutos no servidor.

# O agendador funciona somente enquanto o processo Web estiver ativo.
NFE_AUTO_SYNC_ENABLED=1
NFE_AUTO_SYNC_WEEKDAYS=0,1,2,3,4,5,6
NFE_AUTO_SYNC_MAX_LOTES=50
# Recuperação pontual pausada na versão estável.
NFE_RECOVERY_ENABLED=0

# Avisos de Operação não Realizada (210240).
# Destinatários: Admin → Alertas por e-mail; arquivo secrets/email-recipients.json.
# Remetente/usuário salvos pela tela em secrets/smtp-sender.json prevalecem sobre o ambiente.
# A senha SMTP, se necessária, fica somente em secrets/smtp-password.txt.
NFE_SMTP_HOST=
NFE_SMTP_PORT=587
NFE_SMTP_SECURITY=starttls
NFE_SMTP_FROM=
NFE_SMTP_USER=

# Para um servidor em produção, configurar no ambiente do processo:
# NFE_WEB_ENV=production
# NFE_WEB_CSRF_SECRET=<valor aleatório de pelo menos 32 caracteres>
# NFE_CERT_STORE=LocalMachine
# NFE_CERT_THUMBPRINT=<impressão digital quando necessário>
# Para desativar a rotina automática: NFE_AUTO_SYNC_ENABLED=0
# Janela externa: 22:00 inclusive até 04:00 exclusiva, Brasília (UTC-3).
# Disparos: 22:00, 23:00, 00:00, 01:00, 02:00 e 03:00. Não dispara às 04:00.
# Qive: janela solicitada 08:00-18:00, incluindo novas tentativas.
# O app não verifica nem configura a janela do Qive.
# Política e atendimento: DISTRIBUICAO_DFE_QIVE.md.

