# Exemplo de variáveis não sensíveis/operacionais.
# INICIAR_WEB.cmd NÃO carrega este arquivo automaticamente.
# As senhas do banco, administrador e certificado são lidas de secrets/.

NFE_WEB_ENV=development
# Em produção, usar um gateway de autenticação corporativa; sem senha de usuário no app.
# O gateway deve autenticar a pessoa, remover cabeçalhos recebidos do cliente e
# injetar X-NFE-User e X-NFE-Proxy-Secret. Configure o segredo no ambiente do serviço.
# NFE_WEB_AUTH_MODE=proxy
# NFE_WEB_ADMIN_USERS=DOMINIO\\luan.a,DOMINIO\\outro.admin
# NFE_WEB_PROXY_SECRET=<valor aleatório de pelo menos 32 caracteres>
NFE_WEB_HOST=127.0.0.1
NFE_WEB_PORT=8080
NFE_WEB_FORWARDED_ALLOW_IPS=127.0.0.1
NFE_CERT_STORE=CurrentUser
NFE_SEFAZ_COOLDOWN_MINUTES=120

# O agendador funciona somente enquanto o processo Web estiver ativo.
NFE_AUTO_SYNC_ENABLED=0
NFE_AUTO_SYNC_HOUR=8
NFE_AUTO_SYNC_MINUTE=0
NFE_AUTO_SYNC_WEEKDAYS=0,1,2,3,4
NFE_AUTO_SYNC_MAX_LOTES=50

# Avisos de Operação não Realizada (210240).
# Os destinatários são editados pelo admin em Atualizar e ficam em secrets/email-recipients.json.
# A senha SMTP, se necessária, fica somente em secrets/smtp-password.txt.
NFE_SMTP_HOST=
NFE_SMTP_PORT=587
NFE_SMTP_SECURITY=starttls
NFE_SMTP_FROM=
NFE_SMTP_USER=

# Para um servidor em produção, configurar no ambiente do processo:
# NFE_WEB_ENV=production
# NFE_WEB_CSRF_SECRET=<valor aleatório de pelo menos 32 caracteres>
# NFE_CERT_STORE=LocalMachine
# NFE_CERT_THUMBPRINT=<impressão digital quando necessário>
# NFE_AUTO_SYNC_ENABLED=1 após validação da rotina automática
